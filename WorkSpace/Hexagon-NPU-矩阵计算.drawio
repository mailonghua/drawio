  <diagram name="第 1 页" id="U6WUpQG4fDAtpphUVfao">
    <mxGraphModel dx="949" dy="1965" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;相关概念：&lt;/span&gt;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;HVX和HMX都可以单独的进行矩阵乘法&lt;/li&gt;&lt;li&gt;HMX进行矩阵乘，此时HVX就会干HMX不会做的事情：把Q4/Q8等权重反量化成FP16tile,再把HMX吐出的数据转换成FP32&lt;/li&gt;&lt;li&gt;HMX只吃FP16的数据,&lt;/li&gt;&lt;li&gt;HVX可以使用多种数据类型：Q4_0、Q4_1、Q4_K、Q8_0、Q5_K、Q6_K、Q3_K、Q2_K、Q2_0、Q1_0、IQ4_NL、MXFP4，另外还有 F16、F32、BF16&lt;/li&gt;&lt;li&gt;在llama.cpp中即实现了HMX的矩阵乘法算子，又实现了HVX的矩阵乘法算子(kparams-&amp;gt;n_hmx参数控制)&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="250" width="380" x="130" y="50" as="geometry" />
        </mxCell>
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-3" parent="1" style="rounded=1;dashed=1;dashPattern=8 4;strokeWidth=2;strokeColor=#d79b00;fillColor=#fff8ef;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#9c6b00;" value="循环 i：一段权重通道 n_chunk。r 和 c 结束后，这一块就写回 DDR，不等下一批激活" vertex="1">
          <mxGeometry height="1160" width="760" x="160" y="670" as="geometry" />
        </mxCell>
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-4" parent="1" style="rounded=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#6c8ebf;fillColor=#f7fbff;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3d5a80;" value="循环 r：当前这批激活里，每次 32 行" vertex="1">
          <mxGeometry height="600" width="560" x="190" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-5" parent="1" style="rounded=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#9673a6;fillColor=#fbf7fc;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#6b4c7a;" value="循环 c：当前这段权重里，每次 32 个通道" vertex="1">
          <mxGeometry height="370" width="500" x="220" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-6" parent="1" style="rounded=0;html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" value="入口 hmx_mm_2d_f32" vertex="1">
          <mxGeometry height="46" width="240" x="410" y="330" as="geometry" />
        </mxCell>
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-7" parent="1" style="rhombus;html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="mr：还有下一批激活行？" vertex="1">
          <mxGeometry height="110" width="280" x="390" y="400" as="geometry" />
        </mxCell>
        <mxCell id="2AXg5rdfTnBB7JXDY2-q-8" parent="1" style="rounded=0;html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" value="各块都已写回&#xa;DDR 上是完整矩阵" vertex="1">
